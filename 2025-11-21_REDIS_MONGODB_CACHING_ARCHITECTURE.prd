## API Query Strategy

### Smart Data Routing

```typescript
// lib/smart-data-fetcher.ts

async function getDataSmartly(
  feed: FeedType,
  accountId: string | null,
  startDate: string,
  endDate: string
) {
  const today = new Date().toISOString().split('T')[0];
  const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];

  // STRATEGY 1: Hot Data (Today/Yesterday) → Redis
  if (startDate >= yesterday && endDate <= today) {
    console.log('[SMART_FETCH] Hot data query - checking Redis cache');

    const cached = await redisCache.get(feed, accountId, startDate, endDate);
    if (cached) {
      return { data: cached, source: 'redis', loadTime: '50-100ms' };
    }

    // Redis miss → Check MongoDB
    console.log('[SMART_FETCH] Redis miss - checking MongoDB');
    const dbData = await mongodb.query(feed, accountId, startDate, endDate);

    if (dbData.length > 0) {
      // Cache in Redis for next time
      await redisCache.set(feed, accountId, startDate, endDate, dbData);
      return { data: dbData, source: 'mongodb', loadTime: '200-500ms' };
    }

    // MongoDB miss → Fetch from API
    console.log('[SMART_FETCH] MongoDB miss - fetching from API');
    const apiData = await fetchFromAPI(feed, accountId, startDate, endDate);

    // Save to MongoDB
    await mongodb.save(feed, apiData);

    // Cache in Redis
    await redisCache.set(feed, accountId, startDate, endDate, apiData);

    return { data: apiData, source: 'api', loadTime: '30-60s' };
  }

  // STRATEGY 2: Warm Data (Last 90 days) → MongoDB
  const ninetyDaysAgo = new Date(Date.now() - 90 * 86400000).toISOString().split('T')[0];

  if (startDate >= ninetyDaysAgo) {
    console.log('[SMART_FETCH] Warm data query - checking MongoDB');

    const dbData = await mongodb.query(feed, accountId, startDate, endDate);

    if (dbData.length > 0) {
      return { data: dbData, source: 'mongodb', loadTime: '200-500ms' };
    }

    // Not in MongoDB → Fetch from API and save
    const apiData = await fetchFromAPI(feed, accountId, startDate, endDate);
    await mongodb.save(feed, apiData);

    return { data: apiData, source: 'api', loadTime: '30-60s', cached: true };
  }

  // STRATEGY 3: Cold Data (>90 days) → API only
  console.log('[SMART_FETCH] Cold data query - fetching from API');

  const apiData = await fetchFromAPI(feed, accountId, startDate, endDate);

  // Optional: Save to MongoDB for future queries
  await mongodb.save(feed, apiData);

  return { data: apiData, source: 'api', loadTime: '30-60s' };
}
```

