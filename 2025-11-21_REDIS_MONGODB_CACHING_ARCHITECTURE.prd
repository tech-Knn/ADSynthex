## Data Consistency Validation

### Verification Queries

```typescript
// Check if individual account totals match overall totals

async function verifyDataConsistency(feed: FeedType, date: string) {
  // Get individual account totals
  const individualTotals = await mongodb.aggregate([
    { $match: { feed_type: feed, date: date } },
    { $group: {
        _id: '$account_id',
        total_cost: { $sum: '$cost_micros' },
        total_revenue: { $sum: '$revenue_usd' }
      }
    }
  ]);

  // Get overall total
  const overallTotal = await mongodb.aggregate([
    { $match: { feed_type: feed, date: date } },
    { $group: {
        _id: null,
        total_cost: { $sum: '$cost_micros' },
        total_revenue: { $sum: '$revenue_usd' }
      }
    }
  ]);

  // Verify
  const individualSum = individualTotals.reduce((sum, acc) =>
    sum + acc.total_cost, 0
  );

  const difference = Math.abs(individualSum - overallTotal.total_cost);

  if (difference > 100) { // Allow $0.01 rounding error
    console.error(`[CONSISTENCY_CHECK] Data mismatch for ${feed} on ${date}`);
    console.error(`Individual sum: ${individualSum}, Overall: ${overallTotal.total_cost}`);
    return { valid: false, difference };
  }

  return { valid: true, difference: 0 };
}
```

